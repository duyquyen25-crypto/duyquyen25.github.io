\begin{ex}
 Tìm các giá trị của m để hàm số $y=\ln \left[ 7x^2 + (m - 5)x + (- m - 5) \right]$ xác định với mọi $x\in \mathbb{R}$.
\choice
{ $\forall m \in \mathbb{R}$ }
   { \True không tồn tại $m$ }
     { không tồn tại $m$ }
    { $\forall m \in \mathbb{R}$ }
\loigiai{ 

 Ta có: $y=\ln \left[ 7x^2 + (m - 5)x + (- m - 5) \right]$ xác định khi $7x^2 + (m - 5)x + (- m - 5)>0$.

$\Delta =\left(m - 5\right)^{2}-4.7.(- m - 5)=m^{2} + 18 m + 165$.

$7x^2 + (m - 5)x + (- m - 5)>0$ với mọi $x\in \mathbb{R}$ khi và chỉ khi $\Delta <0$

$\Rightarrow m^{2} + 18 m + 165 <0 \Rightarrow$ không tồn tại $m$. 
 }\end{ex}

