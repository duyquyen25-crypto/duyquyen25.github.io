	% 3) Điểm N sao cho AN//MD, AN=MD (Tứ giác ANDM là hình bình hành nên vecto AN = vecto MD)
	\coordinate (N) at ($(A)+(D)-(M)$);
	% 6) H là trung điểm của SN 
	\coordinate (H) at ($(S)!0.5!(N)$);
	% Vẽ các nét liền: bổ sung thêm ND (4) và SN (5)
	\draw (S)--(B) (S)--(C) (S)--(D) (B)--(C)--(D) (N)--(D) (S)--(N);
