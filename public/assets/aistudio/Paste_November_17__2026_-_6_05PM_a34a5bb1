\shortans[4]{1,4}

\loigiai{ 
 Gọi ${H}$ là trung điểm của ${AB}\Rightarrow SH \bot (ABCD)$.

Kẻ $HI\bot SA \Rightarrow BC \bot HI$.

Tam giác ${SAB}$ vuông cân nên $SH=HA=\dfrac{AB}{2}=2$.

$SA=SH\sqrt {2}= 2\sqrt {2}=2 \sqrt{2}$.

$d(BC,SA)=2HI=SA=2 \sqrt{2}=1,4$. 
 }\end{ex}

\begin{ex}
