\loigiai{ 
 $\log_{3}(5 x - 6)=7 \Rightarrow 5 x - 6=3^7\Rightarrow x= \frac{2193}{5}$. 
 }\end{ex}

\begin{ex}
 Giải phương trình $\sqrt[3]{ {6}^{2 x} }-6^{231}=0$.
\loigiai{ 
 $\sqrt[3]{ {6}^{2 x} }-6^{231}=0$ $\Leftrightarrow 6^{\frac{2 x}{3}}=6^{231}$

$ \Leftrightarrow \frac{2 x}{3}=231 \Rightarrow x=\frac{693}{2}$.

 
 }\end{ex}

\begin{ex}
 Giải phương trình $10 . 3^{x} - 10 . 9^{x}=- 14 . 3^{x} + 11 . 9^{x}$.


\loigiai{ 
 $10 . 3^{x} - 10 . 9^{x}=- 14 . 3^{x} + 11 . 9^{x}\Leftrightarrow 24 . 3^{x}=21 . 9^{x}$ 

 $\Leftrightarrow \left(\frac{1}{3}\right)^x=\frac{7}{8}$$\Leftrightarrow x=\log_{\frac{1}{3}} \left(\frac{7}{8}\right)$. 
 }\end{ex}

\begin{ex}
 Giải phương trình $2^{x} + 2^{x - 1} + 2^{x + 2}=2 . 4^{x} + 4^{x - 2}$.
\loigiai{ 
 $2^{x} + 2^{x - 1} + 2^{x + 2}=2 . 4^{x} + 4^{x - 2}\Leftrightarrow 2^x+\frac{1}{2}.2^x+\frac{1}{4}.2^x=4^x+\frac{1}{16}.4^x+1.4^x$ 

$\Leftrightarrow \frac{11}{2}.2^x=\frac{33}{16}.4^x \Leftrightarrow \left( \frac{1}{2}\right)^x=\frac{3}{8}$$\Leftrightarrow x=\log_{\frac{1}{2}} \left(\frac{3}{8}\right)$. 
 }\end{ex}

\begin{ex}
 Giải phương trình $2^{x} + 2^{x + 1} + 2^{x + 2}=4^{x} + 4^{x - 2} + 4^{x + 1}$.
\loigiai{ 
 $2^{x} + 2^{x + 1} + 2^{x + 2}=4^{x} + 4^{x - 2} + 4^{x + 1}\Leftrightarrow 2^x+2.2^x+\frac{1}{4}.2^x=4^x+\frac{1}{16}.4^x+4.4^x$ 

$\Leftrightarrow 7.2^x=\frac{81}{16}.4^x \Leftrightarrow \left( \frac{1}{2}\right)^x=\frac{81}{112}$$\Leftrightarrow x=\log_{\frac{1}{2}} \left(\frac{81}{112}\right)$. 
 }\end{ex}

\begin{ex}
 Giải phương trình $\log_5(9 x - 9) - \log_5(4 x - 5)=3$.
\loigiai{ 
 Điều kiện: $9 x - 9>0$ và $4 x - 5>0$.

$\log_5(9 x - 9) - \log_5(4 x - 5)=3\Leftrightarrow \log_5\frac{9 x - 9}{4 x - 5}=3\Leftrightarrow \frac{9 x - 9}{4 x - 5}=5^3$

$\Leftrightarrow 9 x - 9=125(4 x - 5)\Leftrightarrow x=\frac{616}{491}$. 
 }\end{ex}

\begin{ex}
 Giải bất phương trình $4^{x^{2} + 9 x - 30} \ge 4^{- 2 x^{2} + 3 x - 6}$.
\loigiai{ 
 $4^{x^{2} + 9 x - 30} \ge 4^{- 2 x^{2} + 3 x - 6}$

$\Leftrightarrow x^{2} + 9 x - 30 \ge - 2 x^{2} + 3 x - 6$

$\Leftrightarrow 3 x^{2} + 6 x - 24\ge 0$

$\Leftrightarrow x\le -4$ hoặc $x\ge 2$ 
 }\end{ex}
